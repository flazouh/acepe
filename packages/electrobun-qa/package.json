{
	"name": "electrobun-qa",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"bin": {
		"electrobun-qa": "./src/bin.ts"
	},
	"scripts": {
		"cli": "bun src/bin.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint:effect": "effect-language-service diagnostics --project tsconfig.json --strict --format pretty",
		"test": "bun --bun vitest run"
	},
	"dependencies": {
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/language-service": "catalog:",
		"@effect/vitest": "catalog:",
		"bun-types": "1.3.5",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
